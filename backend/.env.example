PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=highway_led_control

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# MQTT broker is an unresolved Open Issue (SRS §13.1 item 8) — point this at
# whatever broker the transmitter firmware is configured to use.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to "true" only when a TLS-terminating reverse proxy sits in front of
# this app and forwards X-Forwarded-Proto. Leave false for local dev and for
# the docker-compose stack, which has no TLS layer — see docs/RUNBOOK.md.
ENFORCE_HTTPS=false

# Default Admin user created by `npm run seed` (change immediately after first login)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
