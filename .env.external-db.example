# Copy to .env before running with docker-compose.external-db.yml.
# Never commit the real .env.
#
# Prefixed APP_ to avoid colliding with OS-level environment variables of
# the same short name (Docker Compose prioritizes those over this file) —
# see the note at the top of docker-compose.external-db.yml.
APP_DB_HOST=203.0.113.10
APP_DB_PORT=3306
APP_DB_USER=root
APP_DB_PASSWORD=change-me
APP_DB_NAME=highway_led_control

APP_JWT_SECRET=change-me-to-a-long-random-string
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=change-me-immediately-after-first-login
